# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string
# Docker dev DB (docker compose up -d): port 5433 avoids clashing with a local Postgres on 5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/safari_strives

# JWT signing key (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
