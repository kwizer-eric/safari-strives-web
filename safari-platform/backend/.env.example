# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string
# Local docker compose (db only): host port 5433
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/safari_strives
#
# Production compose (api + db): use the Docker service hostname `db` and port 5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/safari_strives

# JWT signing key (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Uvicorn listen port (Docker / hosts that inject $PORT)
PORT=4000

# Comma-separated list of allowed frontend origins (your Vercel URL in prod)
CORS_ORIGINS=http://localhost:3000
