# Runtime config for the FastAPI API + Alembic.
# Copy to `.env` and edit. Never commit a real SECRET_KEY.

ENVIRONMENT=development

PORT=4000
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/safari_strives

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Comma-separated frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# --- Production (Railway) ---
# ENVIRONMENT=production
# SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">
# DATABASE_URL is injected automatically when you link the Railway Postgres plugin
# CORS_ORIGINS=https://your-frontend.up.railway.app
# No RUN_SEED — production content comes from the admin dashboard only.

# --- Phase 4: submission notification email (optional locally) ---
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Phase 5: Cloudflare R2 / S3 (optional until media uploads are needed) ---
# R2 example endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
S3_REGION=auto
