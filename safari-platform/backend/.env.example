# Runtime config for the FastAPI API + Alembic.
# Copy to `.env` and edit. Never commit a real SECRET_KEY.

ENVIRONMENT=development

PORT=4000
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/safari_strives

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Comma-separated frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000
