# Optional override for the FastAPI backend's v1 API base URL. Defaults to
# `${DEFAULT_BACKEND_URL}/api/v1` (see @safari/shared) if unset.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production (Railway) — set in the frontend service variables BEFORE build:
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api/v1
