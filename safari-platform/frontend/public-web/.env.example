# Optional override for the FastAPI backend's v1 API base URL.
# Defaults to `${DEFAULT_BACKEND_URL}/api/v1` (see @safari/shared) if unset.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-side preferred URL (SSR / Railway). Same value as NEXT_PUBLIC_API_URL.
# If only NEXT_PUBLIC_* is set, that is used as fallback.
API_URL=http://localhost:4000/api/v1

# Production (Railway) — set BOTH on the frontend service, then redeploy:
# API_URL=https://your-backend.up.railway.app/api/v1
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api/v1
