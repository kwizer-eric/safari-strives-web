{
  "name": "safari-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Safari Strives frontend monorepo",
  "workspaces": [
    "packages/*",
    "public-web"
  ],
  "scripts": {
    "dev": "npm run dev -w public-web",
    "build": "node scripts/build.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
