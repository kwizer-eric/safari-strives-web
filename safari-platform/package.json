{
  "name": "safari-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Safari Strives platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,public,admin,applicant,mentor,partner -c blue,green,cyan,yellow,magenta,red \"npm:dev:backend\" \"npm:dev:public\" \"npm:dev:admin\" \"npm:dev:applicant\" \"npm:dev:mentor\" \"npm:dev:partner\"",
    "dev:backend": "npm run dev -w backend",
    "dev:public": "npm run dev -w public-web",
    "dev:admin": "npm run dev -w admin-dashboard",
    "dev:applicant": "npm run dev -w applicant-portal",
    "dev:mentor": "npm run dev -w mentor-portal",
    "dev:partner": "npm run dev -w partner-portal",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
